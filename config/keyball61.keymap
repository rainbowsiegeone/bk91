/*
 * Keyball61 (ZMK). Раскладка перенесена из QMK keymaps/via, слои 0-3.
 * Порядок клавиш: 5 рядов, в каждом сначала левая половина, затем правая.
 * Пока собирается только правая половина, клавиши левой половины просто не нажимаются.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "base";
            bindings = <
            &kp ESC         &kp N1          &kp N2          &kp N3          &kp N4          &kp N5          &kp N6          &kp N7          &kp N8          &kp N9          &kp N0          &kp MINUS
            &kp DEL         &kp Q           &kp W           &kp E           &kp R           &kp T           &kp Y           &kp U           &kp I           &kp O           &kp P           &kp INT_YEN
            &kp TAB         &kp A           &kp S           &kp D           &kp F           &kp G           &kp H           &kp J           &kp K           &kp L           &kp SEMI        &kp LS(N7)
            &mo 1           &kp Z           &kp X           &kp C           &kp V           &kp B           &kp RBKT        &kp NON_US_HASH  &kp N           &kp M           &kp COMMA       &kp DOT         &kp FSLH        &kp RSHFT
            &trans          &kp LCTRL       &kp LALT        &kp LGUI        &lt 1 LANG2     &lt 2 SPACE     &lt 3 LANG1     &kp BSPC        &lt 2 RET       &lt 1 LANG2     &kp RGUI        &trans          &kp RALT        &kp PSCRN
            >;
        };

        shift_sym {
            display-name = "shift_sym";
            bindings = <
            &kp LS(ESC)     &kp LS(N1)      &kp LBKT        &kp LS(N3)      &kp LS(N4)      &kp LS(N5)      &kp EQUAL       &kp LS(N6)      &kp LS(SQT)     &kp LS(N8)      &kp LS(N9)      &kp LS(INT_RO)
            &kp LS(DEL)     &kp LS(Q)       &kp LS(W)       &kp LS(E)       &kp LS(R)       &kp LS(T)       &kp LS(Y)       &kp LS(U)       &kp LS(I)       &kp LS(O)       &kp LS(P)       &kp LS(INT_YEN)
            &kp LS(TAB)     &kp LS(A)       &kp LS(S)       &kp LS(D)       &kp LS(F)       &kp LS(G)       &kp LS(H)       &kp LS(J)       &kp LS(K)       &kp LS(L)       &kp SQT         &kp LS(N2)
            &trans          &kp LS(Z)       &kp LS(X)       &kp LS(C)       &kp LS(V)       &kp LS(B)       &kp LS(RBKT)    &kp LS(NON_US_HASH)  &kp LS(N)       &kp LS(M)       &kp LS(COMMA)   &kp LS(DOT)     &kp LS(FSLH)    &kp LS(RSHFT)
            &trans          &kp LS(LCTRL)   &kp LS(LALT)    &kp LS(LGUI)    &trans          &trans          &trans          &trans          &trans          &trans          &kp LS(RGUI)    &trans          &kp LS(RALT)    &trans
            >;
        };

        num_nav {
            display-name = "num_nav";
            bindings = <
            &none           &kp F1          &kp F2          &kp F3          &kp F4          &kp F5          &kp F6          &kp F7          &kp F8          &kp F9          &kp F10         &kp F11
            &none           &trans          &kp N7          &kp N8          &kp N9          &trans          &trans          &kp LEFT        &kp UP          &kp RIGHT       &trans          &kp F12
            &none           &trans          &kp N4          &kp N5          &kp N6          &kp LS(SEMI)    &kp PG_UP       &mkp LCLK       &kp DOWN        &mkp RCLK       &mkp MCLK       &trans
            &trans          &trans          &kp N1          &kp N2          &kp N3          &kp LS(MINUS)   &kp LS(N8)      &kp LS(N9)      &kp PG_DN       &trans          &trans          &trans          &trans          &trans
            &trans          &trans          &kp N0          &kp DOT         &trans          &trans          &trans          &kp DEL         &trans          &trans          &trans          &trans          &trans          &trans
            >;
        };

        scroll_sys {
            display-name = "scroll_sys";
            bindings = <
            &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &bt BT_CLR      &tog 4         &tog 5         &tog 6         &tog 7         &to 0          &none
            &none           &none           &none           &none           &trans          &trans          &none           &none           &none           &none           &trans          &trans
            &none           &none           &none           &none           &trans          &trans          &none           &none           &none           &none           &none           &none
            &trans          &trans          &none           &none           &none           &none           &none           &none           &kp HOME        &kp PG_DN       &kp PG_UP       &kp END         &trans          &trans
            &bootloader     &trans          &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT       &trans          &trans          &kp BSPC        &trans          &trans          &trans          &trans          &bootloader
            >;
        };

        cursor_slow {
            display-name = "cursor_slow";
            bindings = <
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
        cursor_fast {
            display-name = "cursor_fast";
            bindings = <
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
        scroll_slow_flag {
            display-name = "scroll_slow_flag";
            bindings = <
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
        scroll_fast_flag {
            display-name = "scroll_fast_flag";
            bindings = <
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
        scroll_slow_active {
            display-name = "scroll_slow_active";
            bindings = <
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
        scroll_fast_active {
            display-name = "scroll_fast_active";
            bindings = <
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
