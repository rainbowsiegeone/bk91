/*
 * Keyball61: дуплексная матрица, прочитанная как charlieplex.
 *
 * Порядок пинов в gpios (индексы 0..8):
 *   0..4 = ROW0..ROW4  (Pro Micro D4, D5, D6, D7, D8)
 *   5..8 = COL0..COL3  (Pro Micro A3, A2, A1, A0 = номера 18, 19, 20, 21)
 *
 * В charlieplex-драйвере ZMK строка (row) = пин, на который подаётся напряжение,
 * столбец (col) = пин, с которого читаем. Диоды на плате стоят под активно-низкое
 * сканирование QMK, поэтому «ведущим» пином в ZMK становится тот, который в QMK
 * был читаемым. Подробности в README.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-charlieplex";
        /* interrupt-gpios не задан -> постоянный опрос (для проверки это нормально) */
        gpios
            = <&pro_micro 4  GPIO_ACTIVE_HIGH>   /* ROW0 */
            , <&pro_micro 5  GPIO_ACTIVE_HIGH>   /* ROW1 */
            , <&pro_micro 6  GPIO_ACTIVE_HIGH>   /* ROW2 */
            , <&pro_micro 7  GPIO_ACTIVE_HIGH>   /* ROW3 */
            , <&pro_micro 8  GPIO_ACTIVE_HIGH>   /* ROW4 */
            , <&pro_micro 18 GPIO_ACTIVE_HIGH>   /* COL0 */
            , <&pro_micro 19 GPIO_ACTIVE_HIGH>   /* COL1 */
            , <&pro_micro 20 GPIO_ACTIVE_HIGH>   /* COL2 */
            , <&pro_micro 21 GPIO_ACTIVE_HIGH>   /* COL3 */
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <18>;   /* 9 для левой половины + 9 для правой */
        rows = <9>;
        map = <
            RC(5,0) RC(6,0) RC(7,0) RC(0,5) RC(0,6) RC(0,7) RC(0,16) RC(0,15) RC(0,14) RC(7,9) RC(6,9) RC(5,9)
            RC(5,1) RC(6,1) RC(7,1) RC(1,5) RC(1,6) RC(1,7) RC(1,16) RC(1,15) RC(1,14) RC(7,10) RC(6,10) RC(5,10)
            RC(5,2) RC(6,2) RC(7,2) RC(2,5) RC(2,6) RC(2,7) RC(2,16) RC(2,15) RC(2,14) RC(7,11) RC(6,11) RC(5,11)
            RC(5,3) RC(6,3) RC(7,3) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,17) RC(3,16) RC(3,15) RC(3,14) RC(7,12) RC(6,12) RC(5,12)
            RC(5,4) RC(6,4) RC(7,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8) RC(4,17) RC(4,16) RC(4,15) RC(4,14) RC(7,13) RC(6,13) RC(5,13)
        >;
    };
};
